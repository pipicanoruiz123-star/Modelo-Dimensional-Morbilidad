      <replace_field/>
    </formula>
    <formula>
      <field_name>SPK_time</field_name>
      <formula_string>anio_int * 100 + mes_int</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
